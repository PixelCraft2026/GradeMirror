    "results":{"type":"object","additionalProperties":false,"required":["O","OP","LO","LP","Y"],"properties":{"O":{"$ref":"#/$defs/hash"},"OP":{"$ref":"#/$defs/hash"},"LO":{"$ref":"#/$defs/hash"},"LP":{"$ref":"#/$defs/hash"},"Y":{"$ref":"#/$defs/hash"}}},
