{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive advisory plan v1",
  "description": "Recorded snapshot advice is not launch authority. Semantic validation rederives every field and new launches check the real current clock and OS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request",
    "intent_id",
    "snapshot",
    "candidates",
    "selected",
    "execution_authorized",
    "resource_feasible",
    "policy",
    "no_reservation",
    "CPU_ENABLED",
    "AUTO_ENABLED",
    "PRODUCTION_ENABLED",
    "plan_id",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": "adaptive-plan-v1"
    },
    "request": {
      "$ref": "adaptive-intent-v1.json"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "captured_at",
        "available_ram",
        "available_commit",
        "available_vram",
        "existing",
        "own_tree_exited"
      ],
      "properties": {
        "schema": {
          "const": "adaptive-snapshot-v1"
        },
        "captured_at": {
          "type": "number"
        },
        "available_ram": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854776000
            },
            {
              "type": "null"
            }
          ]
        },
        "available_commit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854776000
            },
            {
              "type": "null"
            }
          ]
        },
        "available_vram": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854776000
            },
            {
              "type": "null"
            }
          ]
        },
        "existing": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rss",
                "commit",
                "vram",
                "state"
              ],
              "properties": {
                "rss": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854776000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "commit": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854776000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "vram": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854776000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "state": {
                  "enum": [
                    "FREE",
                    "BUSY",
                    "RESIDENT",
                    "UNKNOWN"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "own_tree_exited": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "candidates": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "resource_feasible",
            "resource_reasons",
            "qualification",
            "execution_authorized",
            "stages",
            "minimum_available_ram",
            "minimum_available_commit",
            "additional_peak_bytes",
            "total_limit_includes_existing",
            "available_already_excludes_OS_usage",
            "estimated_seconds"
          ],
          "properties": {
            "id": {
              "const": "cpu-portable"
            },
            "resource_feasible": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "resource_reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "qualification": {
              "const": "NATIVE_EXECUTION_NOT_QUALIFIED"
            },
            "execution_authorized": {
              "const": false
            },
            "stages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "minimum_available_ram": {
              "type": "integer",
              "minimum": 0
            },
            "minimum_available_commit": {
              "type": "integer",
              "minimum": 0
            },
            "additional_peak_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "total_limit_includes_existing": {
              "const": true
            },
            "available_already_excludes_OS_usage": {
              "const": true
            },
            "estimated_seconds": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "resource_feasible",
            "resource_reasons",
            "qualification",
            "execution_authorized",
            "estimated_seconds"
          ],
          "properties": {
            "id": {
              "const": "current-gpu-hybrid"
            },
            "resource_feasible": {
              "type": "null"
            },
            "resource_reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "qualification": {
              "const": "HISTORICAL_SCOPE_ONLY"
            },
            "execution_authorized": {
              "const": false
            },
            "estimated_seconds": {
              "type": "null"
            }
          }
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "selected": {
      "enum": [
        "cpu-portable",
        null
      ]
    },
    "execution_authorized": {
      "const": false
    },
    "resource_feasible": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "const": "adaptive-application-v1"
    },
    "no_reservation": {
      "const": true
    },
    "CPU_ENABLED": {
      "const": false
    },
    "AUTO_ENABLED": {
      "const": false
    },
    "PRODUCTION_ENABLED": {
      "const": false
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "quality",
              "operations",
              "version",
              "bundle_id",
              "math_id",
              "producer_build",
              "runtime_requirements",
              "source_identity",
              "reference_identity",
              "source_format",
              "reference_format",
              "evidence_manifest",
              "native_execution_qualified",
              "execution_authorized",
              "mathematical_data_loaded",
              "request_metadata_matches_saved_input",
              "saved_recipe_identity_match",
              "quality_and_operation_match",
              "runtime_and_executor_qualification",
              "qualification_reasons"
            ],
            "properties": {
              "id": {
                "enum": [
                  "cpu-fast-portable",
                  "cpu-fine-portable"
                ]
              },
              "quality": {
                "enum": [
                  "fast",
                  "fine"
                ]
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "version": {
                "enum": [
                  2,
                  3
                ]
              },
              "bundle_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "math_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "producer_build": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "runtime_requirements": {
                "type": "object"
              },
              "source_identity": {
                "type": "object"
              },
              "reference_identity": {
                "type": "object"
              },
              "source_format": {
                "type": "string"
              },
              "reference_format": {
                "type": "string"
              },
              "evidence_manifest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "bytes",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "native_execution_qualified": {
                "const": false
              },
              "execution_authorized": {
                "const": false
              },
              "mathematical_data_loaded": {
                "const": false
              },
              "request_metadata_matches_saved_input": {
                "type": "boolean"
              },
              "saved_recipe_identity_match": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quality_and_operation_match": {
                "type": "boolean"
              },
              "runtime_and_executor_qualification": {
                "const": "PENDING_CURRENT_BUILD_QUALIFICATION"
              },
              "qualification_reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "quality",
              "operations",
              "version",
              "native_execution_qualified",
              "execution_authorized",
              "request_metadata_matches_saved_input",
              "saved_recipe_identity_match",
              "quality_and_operation_match",
              "runtime_and_executor_qualification",
              "qualification_reasons",
              "evidence"
            ],
            "properties": {
              "id": {
                "enum": [
                  "cuda-fast",
                  "cuda-fine",
                  "cuda-r0-cpu-lld10-v1"
                ]
              },
              "quality": {
                "type": "null"
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "version": {
                "type": "null"
              },
              "native_execution_qualified": {
                "const": false
              },
              "execution_authorized": {
                "const": false
              },
              "request_metadata_matches_saved_input": {
                "type": "null"
              },
              "saved_recipe_identity_match": {
                "type": "null"
              },
              "quality_and_operation_match": {
                "type": "null"
              },
              "runtime_and_executor_qualification": {
                "const": "EXISTING_MANUAL_SCOPE_ONLY"
              },
              "qualification_reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  }
}
